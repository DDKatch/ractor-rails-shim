# frozen_string_literal: true

source 'https://rubygems.org'
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby '4.0.7'

# benchmark/base64 stopped being Ruby default gems in 4.0 — mini_magick (an ActiveStorage
# ImageMagick-analyzer dependency) requires 'benchmark' without declaring it, which silently
# aborts ActiveStorage::Engine's config block mid-way (breaks config.active_storage.queues).
gem 'benchmark'
gem 'base64'

# Bundle edge Rails instead: gem 'rails', github: 'rails/rails'
gem 'rails', '~> 8.1.3'

# Use postgresql as the database for Active Record
gem 'pg', '>= 0.18', force_ruby_platform: true
# Use Falcon as the app server
gem 'falcon', '~> 0.55'
# Renders Gemini-synthesized markdown (ChangelogDigestMailer) to actual HTML — simple_format alone
# only turns newlines into <p>/<br>, so **bold**/## headers/- lists showed up as literal symbols.
gem 'redcarpet'
gem 'async-http', '~> 0.64'
gem 'async-http-faraday'  # Fiber-aware Faraday adapter
gem 'async-redis'         # Fiber-aware Redis client
# Use Puma as the app server (keeping for rollback)
# gem 'puma', '>= 5.6.4'
# Use SCSS for stylesheets
gem 'sass-rails', '~> 5.0'
gem 'sassc-rails'
# Build JSON APIs with ease. Read more: https://github.com/rails/jbuilder
gem 'jbuilder'
gem 'devise'
gem 'devise-jwt'
gem 'rack-attack'
gem 'net-imap'
gem 'net-pop'
gem 'net-smtp'
gem 'matrix'
gem 'mutex_m'

# Use Redis adapter to run Action Cable in production
gem 'redis'
# Use Active Model has_secure_password
gem 'bcrypt'

gem 'sprockets-rails'

# Use Active Storage variant
gem 'image_processing', '~> 1.2'
gem 'aws-sdk-s3', require: false

# Reduces boot times through caching; required in config/boot.rb
gem 'bootsnap', '>= 1.9.3', require: false

gem 'activeadmin', '~> 3.5'
gem 'bootstrap', '~> 4.3.1'
gem 'webpacker'
gem 'fast_jsonapi'
gem 'slim'
gem 'simple_form'
gem 'sitemap_generator'
gem 'tzinfo'
gem 'tzinfo-data', platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem 'translit'
gem 'telegram-bot'
gem 'faraday'
gem 'ferrum'
gem 'json-schema' # JSON Schema validation for API responses
gem 'prawn', '~> 2.5'
gem 'prawn-table', '~> 0.2'

gem 'mailgun-ruby', '~> 1.2'
gem 'solid_queue', '~> 1.7'
gem 'mission_control-jobs'

gem 'feelings', require: false

group :development do
  gem 'annotate',           require: false
end

gem 'kamal', require: false

group :development, :test do
  gem 'dotenv-rails'
  # Call 'byebug' anywhere in the code to stop execution and get a debugger console
  gem 'byebug', platforms: [:mri, :mingw, :x64_mingw]
  # %w[rspec rspec-core rspec-expectations rspec-mocks rspec-support rspec-rails].each do |lib|
  #   # gem lib, git: "https://github.com/rspec/#{lib}.git", branch: 'master'
  #   gem lib
  # end
  gem 'rubocop', '~> 1.72.0', require: false
  gem 'rubocop-rails', '~> 2.28.0', require: false
  gem 'rubocop-performance', require: false
  gem 'shoulda-matchers', '~> 5.0'
  gem 'minitest-reporters'
  # minitest 6.0 extracted Minitest::Mock into this separate gem — the codebase's test/unit_test_helper.rb
  # require 'minitest/mock' and every test file using .stub`/`Minitest::Mock.new depend on it.
  gem 'mutineer', require: false
  gem 'minitest-mock'
  gem 'simplecov', require: false
  gem 'foreman'

  # RBS - Ruby type signatures
  gem 'rbs', require: false
  gem 'steep', require: false
end

group :development do
  # Access an interactive console on exception pages or by calling 'console' anywhere in the code.
  gem 'web-console', '>= 3.3.0'
  gem 'listen'
  gem 'pry'
end


gem 'ruby_llm', '2.1.0'

# gem "bubbletea", "~> 0.1.4", :group => :development
# gem "lipgloss", "~> 0.2.2", :group => :development
# gem "ntcharts", "~> 0.1.2", :group => :development
